# Public Supabase configuration (optional in guided mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# 32-byte key encoded as 64 hex characters; server-only
PROVIDER_KEY_ENCRYPTION_SECRET=

# Server-only OpenRouter platform funding and optional signed video callbacks
OPENROUTER_SYSTEM_API_KEY=
OPENROUTER_SYSTEM_DAILY_JOB_LIMIT=30
OPENROUTER_WEBHOOK_SECRET=
HUGGINGFACE_SYSTEM_DAILY_JOB_LIMIT=10
SHOWCASE_FEED_ENABLED=true
SHOWCASE_3D_ENABLED=true

# Comma-separated emails allowed to bootstrap the first superadmin
ADMIN_EMAIL_ALLOWLIST=

# Public deployment origin, for metadata and callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000
